import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { ParticleBackground } from '../Canvas/ParticleBackground';
import { greeting, skills, experience, degrees, projectsHeader, contactPageData, socialMediaLinks } from '../../portfolio';

const PremiumPortfolio = () => {
  const [isScrolled, setIsScrolled] = useState(false);
  const [userLocation, setUserLocation] = useState(null);

  useEffect(() => {
    const handleScroll = () => setIsScrolled(window.scrollY > 50);
    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  useEffect(() => {
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (position) => {
          setUserLocation({
            lat: position.coords.latitude,
            lng: position.coords.longitude,
          });
        },
        () => console.log('Location access denied')
      );
    }
  }, []);

  // Animation variants
  const containerVariants = {
    hidden: { opacity: 0 },
    visible: {
      opacity: 1,
      transition: { staggerChildren: 0.15, delayChildren: 0.1 },
    },
  };

  const itemVariants = {
    hidden: { y: 20, opacity: 0 },
    visible: {
      y: 0,
      opacity: 1,
      transition: { duration: 0.5, ease: 'easeOut' },
    },
  };

  const fadeInUp = {
    hidden: { opacity: 0, y: 30 },
    visible: {
      opacity: 1,
      y: 0,
      transition: { duration: 0.6, ease: 'easeOut' },
    },
  };

  return (
    <div className="min-h-screen bg-black text-white overflow-hidden">
      <ParticleBackground className="opacity-50" />

      {/* Navigation */}
      <motion.nav
        className={`fixed top-0 w-full z-50 transition-all duration-300 ${
          isScrolled
            ? 'bg-black/80 backdrop-blur-md border-b border-purple-500/20'
            : 'bg-transparent'
        }`}
        initial={{ y: -100 }}
        animate={{ y: 0 }}
        transition={{ delay: 0.2 }}
      >
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
          <motion.div className="flex items-center gap-2" whileHover={{ scale: 1.05 }}>
            <div className="w-10 h-10 rounded-lg bg-gradient-to-br from-purple-500 to-cyan-500 flex items-center justify-center font-bold">
              AS
            </div>
            <span className="text-xl font-bold">Abdul Subhan</span>
          </motion.div>

          <div className="hidden md:flex gap-8">
            {['Home', 'Skills', 'Experience', 'Projects', 'Contact'].map((item) => (
              <motion.a
                key={item}
                href={`#${item.toLowerCase()}`}
                className="text-gray-300 hover:text-purple-400 transition-colors"
                whileHover={{ y: -2 }}
              >
                {item}
              </motion.a>
            ))}
          </div>
        </div>
      </motion.nav>

      {/* Hero Section */}
      <section id="home" className="relative h-screen flex items-center justify-center pt-20">
        <motion.div
          className="text-center z-10 max-w-4xl px-4"
          variants={containerVariants}
          initial="hidden"
          animate="visible"
        >
          <motion.div variants={itemVariants} className="mb-6">
            <span className="text-purple-400 text-lg font-semibold">Welcome to my portfolio</span>
          </motion.div>

          <motion.h1
            variants={itemVariants}
            className="text-6xl md:text-8xl font-bold mb-6 bg-gradient-to-r from-purple-400 via-pink-400 to-cyan-400 bg-clip-text text-transparent"
          >
            Abdul Subhan
          </motion.h1>

          <motion.p
            variants={itemVariants}
            className="text-xl md:text-2xl text-gray-300 mb-8 leading-relaxed"
          >
            {greeting.subTitle}
          </motion.p>

          <motion.div variants={itemVariants} className="flex gap-4 justify-center">
            <motion.a
              href={greeting.resumeLink}
              target="_blank"
              rel="noreferrer"
              className="px-8 py-3 rounded-lg bg-gradient-to-r from-purple-600 to-cyan-600 text-white font-semibold hover:shadow-lg hover:shadow-purple-500/50 transition-all"
              whileHover={{ scale: 1.05 }}
              whileTap={{ scale: 0.95 }}
            >
              View Resume
            </motion.a>
            <motion.a
              href="#projects"
              className="px-8 py-3 rounded-lg border border-purple-500 text-purple-400 font-semibold hover:bg-purple-500/10 transition-all"
              whileHover={{ scale: 1.05 }}
              whileTap={{ scale: 0.95 }}
            >
              Explore Work
            </motion.a>
          </motion.div>

          {/* Social Links */}
          <motion.div variants={itemVariants} className="flex gap-4 justify-center mt-8">
            {socialMediaLinks.map((social) => (
              <motion.a
                key={social.name}
                href={social.link}
                target="_blank"
                rel="noreferrer"
                className="w-12 h-12 rounded-lg flex items-center justify-center hover:shadow-lg transition-all"
                style={{ backgroundColor: social.backgroundColor }}
                whileHover={{ y: -5 }}
              >
                <i className={`fab ${social.fontAwesomeIcon}`}></i>
              </motion.a>
            ))}
          </motion.div>
        </motion.div>

        {/* Scroll Indicator */}
        <motion.div
          className="absolute bottom-10 left-1/2 transform -translate-x-1/2"
          animate={{ y: [0, 10, 0] }}
          transition={{ repeat: Infinity, duration: 2 }}
        >
          <div className="flex flex-col items-center gap-2">
            <span className="text-gray-400 text-sm">Scroll to explore</span>
            <div className="w-6 h-10 border-2 border-purple-400 rounded-full flex justify-center">
              <div className="w-1 h-2 bg-purple-400 rounded-full mt-2"></div>
            </div>
          </div>
        </motion.div>
      </section>

      {/* Skills Section */}
      <section id="skills" className="relative py-20 px-4">
        <div className="max-w-6xl mx-auto">
          <motion.div
            initial={{ opacity: 0 }}
            whileInView={{ opacity: 1 }}
            transition={{ duration: 0.6 }}
          >
            <h2 className="text-5xl font-bold mb-4 text-center">Skills & Expertise</h2>
            <p className="text-gray-400 text-center mb-12">Technologies and tools I master</p>
          </motion.div>

          <motion.div
            className="grid md:grid-cols-2 gap-8"
            variants={containerVariants}
            initial="hidden"
            whileInView="visible"
          >
            {skills.data.map((skill, idx) => (
              <motion.div
                key={idx}
                variants={itemVariants}
                className="bg-gradient-to-br from-purple-900/20 to-cyan-900/20 border border-purple-500/30 rounded-2xl p-8 hover:border-purple-500/60 transition-all hover:shadow-lg hover:shadow-purple-500/20"
                whileHover={{ y: -10 }}
              >
                <h3 className="text-2xl font-bold mb-4">{skill.title}</h3>
                <ul className="space-y-3 mb-6">
                  {skill.skills.map((s, i) => (
                    <li key={i} className="text-gray-300 flex items-start gap-3">
                      <span className="text-cyan-400 mt-1">→</span>
                      {s}
                    </li>
                  ))}
                </ul>
                <div className="flex flex-wrap gap-2">
                  {skill.softwareSkills.map((tech, i) => (
                    <span
                      key={i}
                      className="px-3 py-1 rounded-full bg-purple-500/20 text-purple-200 text-sm border border-purple-500/30"
                    >
                      {tech.skillName}
                    </span>
                  ))}
                </div>
              </motion.div>
            ))}
          </motion.div>
        </div>
      </section>

      {/* Experience Section */}
      <section id="experience" className="relative py-20 px-4 bg-gradient-to-b from-transparent via-purple-900/5 to-transparent">
        <div className="max-w-6xl mx-auto">
          <motion.div
            initial={{ opacity: 0 }}
            whileInView={{ opacity: 1 }}
            transition={{ duration: 0.6 }}
          >
            <h2 className="text-5xl font-bold mb-4 text-center">Experience</h2>
            <p className="text-gray-400 text-center mb-12">Building incredible products and platforms</p>
          </motion.div>

          <motion.div
            className="grid md:grid-cols-2 gap-8"
            variants={containerVariants}
            initial="hidden"
            whileInView="visible"
          >
            {experience.sections[0].experiences.map((exp, idx) => (
              <motion.div
                key={idx}
                variants={itemVariants}
                className="bg-black/40 border border-cyan-500/30 rounded-2xl p-8 hover:border-cyan-500/60 transition-all hover:shadow-lg hover:shadow-cyan-500/20"
                whileHover={{ y: -10 }}
              >
                <div className="flex items-start justify-between mb-4">
                  <div>
                    <h3 className="text-2xl font-bold">{exp.title}</h3>
                    <p className="text-cyan-400">{exp.company}</p>
                  </div>
                  <span className="px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 text-sm">
                    {exp.duration}
                  </span>
                </div>
                <p className="text-gray-300 mb-3">{exp.location}</p>
                <p className="text-gray-400 leading-relaxed">{exp.description}</p>
              </motion.div>
            ))}
          </motion.div>
        </div>
      </section>

      {/* Projects Section */}
      <section id="projects" className="relative py-20 px-4">
        <div className="max-w-6xl mx-auto">
          <motion.div
            initial={{ opacity: 0 }}
            whileInView={{ opacity: 1 }}
            transition={{ duration: 0.6 }}
          >
            <h2 className="text-5xl font-bold mb-4 text-center">Featured Projects</h2>
            <p className="text-gray-400 text-center mb-12">{projectsHeader.description}</p>
          </motion.div>

          <motion.div
            className="space-y-6"
            variants={containerVariants}
            initial="hidden"
            whileInView="visible"
          >
            {[
              {
                title: 'Office Management System',
                description: 'Automated payroll processing and employee attendance tracking',
                url: 'https://www.oms.enigmatix.co/',
              },
              {
                title: 'Elevate Security',
                description: 'Micro-frontend architecture for security risk management platform',
                url: 'https://elevatesecurity.com/',
              },
              {
                title: 'Rent Around',
                description: 'eCommerce platform for influencers and sellers with dedicated interfaces',
                url: 'https://app.rentarround.com/',
              },
            ].map((proj, idx) => (
              <motion.a
                key={idx}
                href={proj.url}
                target="_blank"
                rel="noreferrer"
                variants={itemVariants}
                className="block bg-gradient-to-r from-purple-900/20 via-transparent to-cyan-900/20 border border-purple-500/30 rounded-2xl p-8 hover:border-purple-500/60 transition-all group hover:shadow-lg hover:shadow-purple-500/20"
                whileHover={{ x: 10 }}
              >
                <div className="flex items-center justify-between">
                  <div>
                    <h3 className="text-2xl font-bold mb-2 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-purple-400 group-hover:to-cyan-400 group-hover:bg-clip-text transition-all">
                      {proj.title}
                    </h3>
                    <p className="text-gray-400">{proj.description}</p>
                  </div>
                  <div className="text-3xl group-hover:translate-x-2 transition-transform">→</div>
                </div>
              </motion.a>
            ))}
          </motion.div>
        </div>
      </section>

      {/* Contact Section */}
      <section id="contact" className="relative py-20 px-4 bg-gradient-to-b from-transparent via-purple-900/5 to-transparent">
        <div className="max-w-4xl mx-auto text-center">
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.6 }}
          >
            <h2 className="text-5xl font-bold mb-4">Get In Touch</h2>
            <p className="text-gray-400 mb-8 text-lg">
              {contactPageData.contactSection.description}
            </p>

            <motion.div
              className="grid md:grid-cols-2 gap-8 mb-12"
              variants={containerVariants}
              initial="hidden"
              whileInView="visible"
            >
              <motion.div
                variants={itemVariants}
                className="bg-black/40 border border-cyan-500/30 rounded-2xl p-8"
              >
                <h3 className="text-2xl font-bold mb-2">Location</h3>
                <p className="text-gray-400">
                  {contactPageData.addressSection.subtitle}
                </p>
                <p className="text-gray-400 mt-2">
                  {contactPageData.addressSection.locality}, {contactPageData.addressSection.region}
                </p>
              </motion.div>

              <motion.div
                variants={itemVariants}
                className="bg-black/40 border border-purple-500/30 rounded-2xl p-8"
              >
                <h3 className="text-2xl font-bold mb-4">Connect</h3>
                <div className="flex gap-4 justify-center">
                  {socialMediaLinks.map((social) => (
                    <motion.a
                      key={social.name}
                      href={social.link}
                      target="_blank"
                      rel="noreferrer"
                      className="w-14 h-14 rounded-lg flex items-center justify-center hover:shadow-lg transition-all text-2xl"
                      style={{ backgroundColor: social.backgroundColor }}
                      whileHover={{ y: -5, scale: 1.1 }}
                    >
                      <i className={`fab ${social.fontAwesomeIcon}`}></i>
                    </motion.a>
                  ))}
                </div>
              </motion.div>
            </motion.div>

            <motion.a
              href={greeting.resumeLink}
              target="_blank"
              rel="noreferrer"
              className="inline-block px-12 py-4 rounded-lg bg-gradient-to-r from-purple-600 to-cyan-600 text-white font-semibold hover:shadow-lg hover:shadow-purple-500/50 transition-all"
              whileHover={{ scale: 1.05 }}
              whileTap={{ scale: 0.95 }}
            >
              Download My Resume
            </motion.a>
          </motion.div>
        </div>
      </section>

      {/* Footer */}
      <footer className="relative border-t border-purple-500/20 py-8 px-4">
        <div className="max-w-6xl mx-auto text-center text-gray-400">
          <p>Designed and built by Abdul Subhan © {new Date().getFullYear()}</p>
          {userLocation && (
            <p className="text-sm mt-2 text-gray-500">
              Thanks for visiting from {userLocation.lat.toFixed(2)}, {userLocation.lng.toFixed(2)}
            </p>
          )}
        </div>
      </footer>
    </div>
  );
};

export default PremiumPortfolio;
